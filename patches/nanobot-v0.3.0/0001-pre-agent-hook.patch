+    def _load_pre_agent_hook(self):
+        target = os.environ.get("NANOBOT_PRE_AGENT_HOOK", "").strip()
+        if not target:
+            return None
+        module_name, separator, attribute_name = target.partition(":")
+        if not separator or not module_name or not attribute_name:
+            raise ValueError("NANOBOT_PRE_AGENT_HOOK must use module:callable syntax")
+        hook = getattr(importlib.import_module(module_name), attribute_name, None)
+        if not callable(hook):
+            raise TypeError(f"NANOBOT_PRE_AGENT_HOOK is not callable: {target}")
+        return hook
 
